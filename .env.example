# Example only: set these in cPanel Environment variables, never in Git.
NODE_ENV=production
PUBLIC_ORIGIN=https://test.autohaus.bg
ALLOWED_HOSTS=
# Enable only behind the hosting provider's trusted reverse proxy.
TRUST_PROXY=0

# Optional: existing verified Resend integration. Missing values fail honestly.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Existing Supabase URL/publishable key are configured in this project.
# Authenticated operations use the user's session and existing RLS.
# No service-role key is needed. Do not copy Vercel OIDC tokens.
